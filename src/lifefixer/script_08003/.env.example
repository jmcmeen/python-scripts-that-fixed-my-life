# Catalog Entry 08003 — Self-Directed Notification Pipeline
# Copy to .env. Populating this file is necessary but not sufficient.

# The Gmail address you are emailing (it is you).
GMAIL_ADDRESS=you@gmail.com

# A Gmail App Password. Generating this requires 2FA, which requires a phone,
# which can already do everything this script does. Proceed anyway.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Note: even with these set correctly, the script will not work. See README.md,
